# Private Spudly packages (@spudly/ui) are published to GitHub Packages.
# Authenticate with a token that has read:packages scope:
#   export NODE_AUTH_TOKEN=ghp_xxx   # classic PAT, or use GITHUB_TOKEN in CI
@spudly:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
# Tamagui 3 declares a react >=19 peer, but packages/app pins React 18.3.1
# (Expo SDK 52) and packages/web matches it. Fresh resolutions without this
# fail with ERESOLVE, so resolve peers the legacy way repo-wide.
legacy-peer-deps=true
