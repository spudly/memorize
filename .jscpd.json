{
  "minTokens": 50,
  "minLines": 5,
  "format": ["typescript", "tsx", "javascript"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/.turbo/**",
    "**/.expo/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "**/lingui.config.js"
  ],
  "reporters": ["console", "json"],
  "output": "jscpd-report",
  "gitignore": true,
  "threshold": 9
}
