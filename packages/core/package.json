{
  "dependencies": {
    "@memorize/types": "1.1.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "name": "@memorize/core",
  "private": true,
  "scripts": {
    "build": "node ../../node_modules/typescript7/bin/tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "lint": "eslint src --max-warnings 0",
    "test": "jest --config ../../jest.config.cjs --selectProjects core",
    "typecheck": "node ../../node_modules/typescript7/bin/tsc --noEmit -p tsconfig.check.json"
  },
  "types": "./dist/index.d.ts",
  "version": "1.1.4"
}
