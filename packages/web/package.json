{
  "dependencies": {
    "@lingui/core": "^6.12.0",
    "@lingui/react": "^6.12.0",
    "@memorize/core": "1.1.4",
    "@memorize/types": "1.1.4",
    "@spudly/ui": "^6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native-web": "^0.21.4",
    "tamagui": "^3.1.9"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "^6.12.0",
    "@lingui/cli": "^6.12.0",
    "@lingui/format-po": "^6.12.0",
    "@lingui/vite-plugin": "^6.12.0",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5"
  },
  "name": "@memorize/web",
  "private": true,
  "scripts": {
    "build": "vite build",
    "predev": "node scripts/clearStaleViteCache.mjs",
    "dev": "vite",
    "lint": "echo 'lint disabled until typescript-eslint supports TypeScript 7 (TS sources are excluded in the root eslint.config.ts; JS tooling files are linted by the root lint script)'",
    "preview": "vite preview",
    "test": "npm run i18n:check && lingui compile --strict && node --test src/components/*.test.mjs src/locales/*.test.mjs vite.config.test.mjs",
    "test:e2e": "playwright test --config ../../playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "i18n:extract": "lingui extract && lingui compile",
    "i18n:compile": "lingui compile",
    "i18n:check": "node scripts/checkI18n.mjs"
  },
  "type": "module",
  "version": "1.1.4"
}
