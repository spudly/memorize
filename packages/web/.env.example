# When "1", the web app calls the scripture API through the same-origin
# Vercel edge proxy (packages/web/api) instead of engine.ibeco.me directly,
# which avoids browser CORS restrictions. Production builds get it from
# the committed .env.production (the plain "env" key in vercel.json does
# not reach the Vite build — #63); leave unset for local development.
VITE_USE_GOSPEL_PROXY=

# Server-side only: the gospel-engine API key used by the edge function in
# packages/web/api (read via process.env, deliberately NOT prefixed with
# VITE_ so it is never bundled into the browser build). On Vercel, set this
# in the project settings instead; locally it is only used by `vercel dev`.
GOSPEL_ENGINE_API_KEY=
