# Production builds (the Vercel deployment) serve search through the
# same-origin edge proxy in packages/web/api, which injects the
# gospel-engine API key server-side — so a visitor without a local key
# searches the full library, not the built-in demo set (#63).
#
# This MUST live in a file Vite reads at build time. The plain "env" key
# in vercel.json does not reach the Vite build, and the 2026-10-28
# production build shipped without the flag: import.meta.env compiled
# the proxy branch away and every no-key visitor got the demo set.
# Vite loads this file for `vite build` (mode "production"); an explicit
# process-environment value still wins, so the Playwright demo project
# can pin VITE_USE_GOSPEL_PROXY=0 for its offline build.
VITE_USE_GOSPEL_PROXY=1
