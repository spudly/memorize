{
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@formatjs/intl-locale": "^5.4.2",
    "@formatjs/intl-pluralrules": "^7.0.2",
    "@lingui/core": "^6.12.0",
    "@lingui/react": "^6.12.0",
    "@memorize/core": "1.1.4",
    "@memorize/types": "1.1.4",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@spudly/ui": "^6.0.0",
    "expo": "~58.0.21",
    "expo-font": "~58.0.8",
    "expo-localization": "~58.0.5",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "~0.21.0",
    "tamagui": "^3.1.9"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "^6.12.0",
    "@lingui/cli": "^6.12.0",
    "@lingui/format-po": "^6.12.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.24",
    "jest": "^30.5.2"
  },
  "main": "index.ts",
  "name": "@memorize/app",
  "private": true,
  "scripts": {
    "android": "expo start --android",
    "build": "expo export --platform web --output-dir dist",
    "ios": "expo start --ios",
    "lint": "echo 'lint disabled until typescript-eslint supports TypeScript 7 (TS sources are excluded in the root eslint.config.ts; JS tooling files are linted by the root lint script)'",
    "start": "expo start",
    "test": "npm run i18n:check && lingui compile --strict && jest --config ../../jest.config.cjs --selectProjects app && node --test src/*.test.mjs src/screens/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "i18n:extract": "lingui extract && lingui compile",
    "i18n:compile": "lingui compile",
    "i18n:check": "node scripts/checkI18n.mjs"
  },
  "version": "1.1.4"
}
