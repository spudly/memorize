{
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs,json,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "name": "memorize",
  "packageManager": "npm@10.8.2",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev:web": "turbo dev --filter=@memorize/web",
    "lint": "eslint packages --max-warnings 0",
    "lint:fix": "eslint packages --fix",
    "prepare": "husky",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "test": "turbo test",
    "turbo": "TURBO_TELEMETRY_DISABLED=1 turbo",
    "typecheck": "turbo typecheck"
  },
  "type": "module",
  "workspaces": [
    "packages/types",
    "packages/core",
    "packages/web",
    "packages/app"
  ]
}
