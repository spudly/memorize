{
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@spudly/eslint-config": "^0.2.0",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "semver": "^7.8.5",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs,json,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix --cache --cache-location .eslintcache"
    ]
  },
  "name": "memorize",
  "packageManager": "npm@10.9.4",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev:web": "turbo dev --filter=@memorize/web",
    "knip": "knip",
    "lint": "eslint packages --max-warnings 0",
    "lint:fix": "eslint packages --fix",
    "prepare": "husky || true",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "test": "node --test scripts/lockfileSync.test.mjs && turbo test",
    "turbo": "TURBO_TELEMETRY_DISABLED=1 turbo",
    "typecheck": "turbo typecheck"
  },
  "type": "module",
  "workspaces": [
    "packages/types",
    "packages/core",
    "packages/web",
    "packages/app"
  ],
  "overrides": {
    "test-exclude": "^8.0.0"
  }
}
